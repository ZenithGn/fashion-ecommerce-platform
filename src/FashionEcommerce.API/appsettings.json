{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "<moved-to-.env>"
  },
  "JwtSettings": {
    "SecretKey": "<moved-to-.env>",
    "Issuer": "YourAppName",
    "Audience": "YourAppUsers",
    "ExpirationMinutes": 60
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseStartTls": true,
    "FromName": "Fashion Ecommerce",
    "FromEmail": "your-gmail@gmail.com",
    "Username": "your-gmail@gmail.com",
    "Password": "your-gmail-app-password"
  }
}
